# Режим: production | development | test.
# Пусто/отсутствует = production: при неполной конфигурации приложение НЕ стартует.
# development/test допускают запуск без OAuth (анонимный режим) и WEB_DEV_BYPASS_AUTH.
WEB_ENV=production

# Явный обход авторизации только для development/test.
# В сочетании с WEB_ENV=production запуск запрещён.
WEB_DEV_BYPASS_AUTH=

# MongoDB (обязательное)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=voice_tracker

# Порт API внутри контейнера
WEB_PORT=8000

# Бот-токен: список гильдий бота + действия через Discord REST (этапы 4-5)
# В production обязателен.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Discord OAuth2 (логин сайта) — значения из Developer Portal
# В production обязательны CLIENT_ID, CLIENT_SECRET и SESSION_SECRET (не короче 32 символов).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Обязательно, если не задан WEB_PUBLIC_URL. Должен совпадать по схеме и хосту с WEB_PUBLIC_URL.
DISCORD_REDIRECT_URI=

# Сессия и публичный адрес сайта
# В production обязателен; http разрешён только для localhost/127.0.0.1.
WEB_SESSION_SECRET=
WEB_PUBLIC_URL=
# Абсолютный срок жизни сессии, часов (1..24, по умолчанию 8)
WEB_SESSION_MAX_AGE_HOURS=8

# D01: точный список snowflake'ов гильдий, доступных панели (через запятую).
# В production обязателен и не может быть пустым; в development пусто = без ограничения.
WEB_GUILD_ALLOWLIST=

MEDIA_DIR=
# T16 (L05): порог свободного места на томе MEDIA_DIR для предупреждения в
# /api/readyz (quotaLow/warnings). Read-only сервис: готовность НЕ снимается.
# 0 = выключить проверку. По умолчанию 2 GiB.
WEB_MEDIA_MIN_FREE_BYTES=2147483648

# T16 (L01): бюджет времени одного Mongo-запроса (maxTimeMS), мс (100..60000).
# Превышение → предсказуемый 503 query_timeout вместо зависшей загрузки UI.
WEB_QUERY_MAX_TIME_MS=5000

LOG_LEVEL=INFO
