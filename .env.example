# MongoDB (обязательное)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=voice_tracker

# Порт API внутри контейнера
WEB_PORT=8000

# Бот-токен: список гильдий бота + действия через Discord REST (этапы 4-5)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Discord OAuth2 (логин сайта) — значения из Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://example.invalid/api/auth/callback

# Сессия и публичный адрес сайта
WEB_SESSION_SECRET=
WEB_PUBLIC_URL=https://example.invalid

LOG_LEVEL=INFO
